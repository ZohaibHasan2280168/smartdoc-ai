# =============================================================================
# SmartDoc AI - Environment Configuration Template
# Copy this file to .env before starting the stack
# =============================================================================

# --- Environment & Project ---
ENVIRONMENT=production
DEBUG=false
PROJECT_NAME="SmartDoc AI"

# --- Tier 3: Database (PostgreSQL 15) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=smartdoc_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/smartdoc_db

# --- Tier 3: Cache (Redis 7) ---
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL_SECONDS=3600

# --- Tier 2: AI / LLM Configuration ---
# Optional: Provide your OpenAI API key for live GPT completions.
# If omitted or left empty, SmartDoc AI automatically activates its
# deterministic local offline fallback engine for zero-cost DevOps testing.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

# --- Tier 1: Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
PORT=3000


# Frontend Dashboard: http://localhost:3000
# FastAPI Root: http://localhost:8000
# FastAPI Interactive Docs (Swagger): http://localhost:8000/docs
# Prometheus Metrics: http://localhost:8000/metrics
# Health Check Probe: http://localhost:8000/api/v1/health